// SkillUsageLimit.js\
// \uc0\u25216 \u33021 \u29420 \u31435 \u20351 \u29992 \u27425 \u25968 \u38480 \u21046 \u25554 \u20214 \u65288 \u25903 \u25345 \u27599 \u22330 \u25112 \u26007 \u37325 \u32622 \u65292 \u24182 \u22312 \u25216 \u33021 \u33756 \u21333 \u26174 \u31034 \u21097 \u20313 \u27425 \u25968 \u65289 \
//=============================================================================\
\
/*:\
 * @plugindesc \uc0\u20801 \u35768 \u25216 \u33021 \u35774 \u32622 \u29420 \u31435 \u30340 \u27599 \u36718 /\u27599 \u22330 \u20351 \u29992 \u27425 \u25968 \u38480 \u21046 \u12290 \
 * @author \uc0\u35834 \u36125 \u21033  & \u22934 \u29483 \u26143 \u22812 \
 *\
 * @help\
 * \uc0\u25216 \u33021 \u22791 \u27880 \u26639 \u20889 \u27861 \u65306 \
 * <MaxUse:2>  # \uc0\u20195 \u34920 \u35813 \u25216 \u33021 \u27599 \u22330 \u25112 \u26007 \u26368 \u22810 \u21482 \u33021 \u20351 \u29992  2 \u27425 \
 */\
\
(function() \{\
\
    // 1. \uc0\u25112 \u26007 \u24320 \u22987 \u26102 \u65292 \u21021 \u22987 \u21270 /\u37325 \u32622 \u25152 \u26377 \u35282 \u33394 \u30340 \u25216 \u33021 \u21097 \u20313 \u27425 \u25968 \
    var _Game_Battler_onBattleStart = Game_Battler.prototype.onBattleStart;\
    Game_Battler.prototype.onBattleStart = function() \{\
        _Game_Battler_onBattleStart.call(this);\
        this.initSkillUses();\
    \};\
\
    Game_Battler.prototype.initSkillUses = function() \{\
        this._skillUses = \{\};\
        this.skills().forEach(function(skill) \{\
            var maxUse = Number(skill.meta.MaxUse);\
            if (maxUse) \{\
                this._skillUses[skill.id] = maxUse;\
            \}\
        \}, this);\
    \};\
\
    // 2. \uc0\u26816 \u26597 \u25216 \u33021 \u26159 \u21542 \u36824 \u26377 \u21097 \u20313 \u27425 \u25968 \u21487 \u29992 \
    var _Game_Battler_meetsSkillConditions = Game_Battler.prototype.meetsSkillConditions;\
    Game_Battler.prototype.meetsSkillConditions = function(skill) \{\
        var canUse = _Game_Battler_meetsSkillConditions.call(this, skill);\
        if (!canUse) return false;\
        \
        var maxUse = Number(skill.meta.MaxUse);\
        if (maxUse) \{\
            if (!this._skillUses) this.initSkillUses();\
            var currentUse = this._skillUses[skill.id];\
            if (currentUse === undefined) currentUse = maxUse;\
            return currentUse > 0; // \uc0\u27425 \u25968 \u32791 \u23613 \u21017 \u26080 \u27861 \u20351 \u29992 \
        \}\
        return true;\
    \};\
\
    // 3. \uc0\u20351 \u29992 \u25216 \u33021 \u21518 \u65292 \u25187 \u38500 \u23545 \u24212 \u30340 \u29420 \u31435 \u27425 \u25968 \
    var _Game_Battler_useItem = Game_Battler.prototype.useItem;\
    Game_Battler.prototype.useItem = function(item) \{\
        _Game_Battler_useItem.call(this, item);\
        if (DataManager.isSkill(item)) \{\
            var maxUse = Number(item.meta.MaxUse);\
            if (maxUse) \{\
                if (!this._skillUses) this.initSkillUses();\
                if (this._skillUses[item.id] > 0) \{\
                    this._skillUses[item.id]--;\
                \}\
            \}\
        \}\
    \};\
\
    // 4. \uc0\u22312 \u25112 \u26007 \u30340 \u25216 \u33021 \u36873 \u25321 \u30028 \u38754 \u20013 \u65292 \u21160 \u24577 \u26174 \u31034 \u21097 \u20313 \u27425 \u25968  (\u24403 \u21069 /\u26368 \u22823 )\
    var _Window_SkillList_drawItemName = Window_SkillList.prototype.drawItemName;\
    Window_SkillList.prototype.drawItemName = function(item, x, y, width) \{\
        if (item && DataManager.isSkill(item) && this._actor) \{\
            var maxUse = Number(item.meta.MaxUse);\
            var text = item.name;\
            if (maxUse) \{\
                if (!this._actor._skillUses) this._actor.initSkillUses();\
                var currentUse = this._actor._skillUses[item.id];\
                if (currentUse === undefined) currentUse = maxUse;\
                text += ` ($\{currentUse\}/$\{maxUse\})`; // \uc0\u25340 \u25509 \u21040 \u25216 \u33021 \u21517 \u21518 \
            \}\
            var iconBoxWidth = Window_Base._iconWidth + 4;\
            this.resetTextColor();\
            this.drawIcon(item.iconIndex, x + 2, y + 2);\
            this.drawText(text, x + iconBoxWidth, y, width - iconBoxWidth);\
        \} else \{\
            _Window_SkillList_drawItemName.call(this, item, x, y, width);\
        \}\
    \};\
\
\})();}